# Public, non-secret build configuration.
#
# NEXT_PUBLIC_* values are inlined into the client bundle by Next, so this file
# holds nothing private and is committed on purpose: metadataBase resolves the
# canonical URL and the OG image URL, and leaving the site URL unset makes the
# build emit http://localhost:3000 for both.
#
# Replace the placeholder host with the real one at deploy time.
NEXT_PUBLIC_SITE_URL=https://nor75.example.com